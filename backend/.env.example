DATABASE_URL=sqlite:///./storyverse.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# UTC daily attempt limits, including provider failures.
AI_USER_DAILY_LIMIT=100
AI_ROOM_DAILY_LIMIT=300

# Existing OpenAI behavior remains the default. For self-hosted Qwen:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=qwen3:4b-instruct
# AI_API_KEY=
# AI_REQUEST_TIMEOUT_SECONDS=40
# AI_MAX_OUTPUT_TOKENS=500
# For vLLM / other compatible servers:
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://127.0.0.1:8001/v1
# AI_MODEL=Qwen/Qwen3-4B-Instruct-2507
# AI_API_KEY=server-owned-token
