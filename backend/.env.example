DATABASE_URL=sqlite:///./storyverse.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# UTC daily attempt limits, including provider failures.
AI_USER_DAILY_LIMIT=100
AI_ROOM_DAILY_LIMIT=300

# Existing OpenAI behavior remains the default. For self-hosted Qwen:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://127.0.0.1:11434
# AI_MODEL=qwen3:4b-instruct
# AI_API_KEY=
# AI_REQUEST_TIMEOUT_SECONDS=40
# AI_MAX_OUTPUT_TOKENS=500
# For vLLM / other compatible servers:
# AI_PROVIDER=openai_compatible
# AI_BASE_URL=http://127.0.0.1:8001/v1
# AI_MODEL=Qwen/Qwen3-4B-Instruct-2507
# AI_API_KEY=server-owned-token

# Optional Ollama CPU quota tuning; leave unset to use the model server default.
# AI_OLLAMA_NUM_THREADS=2

# Private Sites bridge only. Never put real values in this example or EXPO_PUBLIC_*.
# IMAGINE_SITE_ID=existing-site-project-id
# IMAGINE_SITE_SERVICE_KEY=
# IMAGINE_WEB_GATEWAY_ONLY=1
# Explicit private gateway permits AI_REQUEST_TIMEOUT_SECONDS up to 180.

# Match the actual model/server context capacity. Increasing this number alone
# does not provide more GPU memory or a model with a larger supported window.
# Confirmed canon + latest instruction are never silently truncated.
# AI_CONTEXT_WINDOW_TOKENS=8192

# Automatic novel writer only. Legacy single-turn output allowance stays separate.
# AI_WRITER_OUTPUT_TOKENS=1200
